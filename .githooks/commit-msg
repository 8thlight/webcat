#!/usr/bin/env bash
# A commit's subject is one sentence saying what is now true: it starts with a capital
# letter and is not empty. Installed by make hooks. Fails closed.
set -euo pipefail

subject="$(sed -n '/^[^#]/{p;q;}' "$1")"
case "$subject" in
  [A-Z]*) ;;
  *)
    echo "commit-msg: refused, the subject is a sentence starting with a capital letter: '$subject'" >&2
    exit 1
    ;;
esac
